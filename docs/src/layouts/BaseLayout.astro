---
import { ClientRouter } from 'astro:transitions';
import {
  AppShell,
  ColorModeToggle,
  cx,
  Layout,
  LayoutContent,
  LayoutPanel,
  MobileNav,
  MobileNavToggle,
  recipeClassName,
  SideNav,
  ThemeScript,
  TopNav,
  TopNavHeading,
  TopNavItem,
} from '@var-ui/astro';
import { codeHljsScope } from '@/styles/codeHighlight';
import { defaultThemeClassName } from '@var-ui/core';
import DocsSearch from '../components/DocsSearch.astro';
import DocsSidebarNav from '../components/DocsSidebarNav.astro';
import FrameworkSwitcher from '../components/FrameworkSwitcher.astro';
import {
  componentSidebarSections,
  themingSidebarSections,
  topNav as topNavItems,
} from '../data/navigation';

const { title = 'Var UI', contentWidth = 'default' } = Astro.props as {
  title?: string;
  contentWidth?: 'default' | 'full';
};
const framework = Astro.locals.framework;
const pathname = Astro.url.pathname;

function normalizePath(path: string): string {
  return path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
}

const currentPath = normalizePath(pathname);

const hljsScopeClass = recipeClassName(codeHljsScope().root);

const sidebarSections = currentPath.startsWith('/components')
  ? componentSidebarSections
  : currentPath.startsWith('/theming')
    ? themingSidebarSections
    : null;

function isSidebarLinkActive(link: string): boolean {
  return currentPath === normalizePath(link);
}
---

<html lang="en" class={defaultThemeClassName} data-framework={framework}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ThemeScript themeClass={defaultThemeClassName} />
    <link rel="stylesheet" href="/typestyles.css" />
    <ClientRouter />
  </head>
  <body class={cx('docs-body', hljsScopeClass)}>
    <AppShell variant="wash" height="fill" contentPadding={0} mobileBreakpoint="md">
      <TopNav slot="topNav">
        <TopNavHeading slot="heading" heading="Var UI" headingHref="/" />
        {
          topNavItems.map((item) => (
            <TopNavItem
              label={item.text}
              href={item.link}
              isSelected={currentPath.startsWith(item.match)}
            />
          ))
        }
        <div slot="end" class="docs-top-nav__tools">
          {sidebarSections ? <MobileNavToggle /> : null}
          <div
            class="docs-top-nav__tools-persist"
            transition:persist="docs-top-nav-tools"
            transition:animate="none"
          >
            <DocsSearch />
            <FrameworkSwitcher />
            <ColorModeToggle includeSystem size="md" />
          </div>
        </div>
      </TopNav>

      {
        sidebarSections && (
          <MobileNav slot="mobileNav" header="Menu">
            <DocsSidebarNav sections={sidebarSections} isLinkActive={isSidebarLinkActive} />
          </MobileNav>
        )
      }

      {
        sidebarSections ? (
          <Layout height="fill" padding={0} className="docs-site-layout">
            <LayoutPanel slot="start" side="start" width={280} hasDivider padding={0} isScrollable={false}>
              <SideNav label="Section navigation" collapsible>
                <DocsSidebarNav sections={sidebarSections} isLinkActive={isSidebarLinkActive} />
              </SideNav>
            </LayoutPanel>
            <LayoutContent label="Main content">
              <div class:list={['docs-content', contentWidth === 'full' && 'docs-content--full']}>
                <slot />
              </div>
            </LayoutContent>
            {
              Astro.slots.has('toc') ? (
                <LayoutPanel
                  slot="end"
                  side="end"
                  width={220}
                  hasDivider
                  padding={0}
                  isScrollable
                  label="On this page"
                >
                  <slot name="toc" />
                </LayoutPanel>
              ) : null
            }
          </Layout>
        ) : (
          <Layout height="fill" padding={6} className="docs-site-layout">
            <LayoutContent label="Main content">
              <div class="docs-content">
                <slot />
              </div>
            </LayoutContent>
          </Layout>
        )
      }
    </AppShell>
    <script>
      import '../../typestyles-entry.ts';
      import '../scripts/reattachTypestyles.ts';
    </script>
  </body>
</html>

<style is:global>
  html,
  body.docs-body {
    height: 100%;
    margin: 0;
  }

  body.docs-body {
    overflow: hidden;
  }

  body.docs-body #var-ui-app-shell-main {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
</style>

<style>
  .docs-top-nav__tools {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .docs-top-nav__tools-persist {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .docs-site-layout {
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
  }

  .docs-content {
    max-width: 60rem;
    margin: 0 auto;
    padding-bottom: 3rem;
  }

  .docs-content--full {
    max-width: none;
    margin: 0;
    padding-inline: var(--var-ui-space-10);
    padding-block: var(--var-ui-space-10);
  }
</style>
