---
import CodeBlock from '@var-ui/docs/CodeBlock';

type Framework = 'react' | 'astro' | 'html';

type Props = {
  code: string;
  language?: string;
  filename: string;
  framework: Framework;
  title?: string;
};

const { code, language = 'tsx', filename, framework, title } = Astro.props;
---

<CodeBlock code={code} language={language} filename={filename} framework={framework} title={title}>
  <slot />
</CodeBlock>
