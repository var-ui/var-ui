---
import { flattenTokenReferenceRows } from '@/lib/theme-css-variables';
import { cssVariableReferenceStyles } from '@/styles/cssVariableReference';
import TokenReferenceTable from './TokenReferenceTable';

const rows = flattenTokenReferenceRows();
const designCount = rows.filter((row) => row.kind === 'design').length;
const componentCount = rows.filter((row) => row.kind === 'component').length;
const c = cssVariableReferenceStyles();
---

<div class={(c.root).className}>
  <section class={(c.section).className} aria-labelledby="token-reference-heading">
    <h2 id="token-reference-heading" class={(c.sectionTitle).className}>Token catalog</h2>
    <p class={(c.sectionDescription).className}>
      {designCount} design tokens and {componentCount} component variables from
      <code>@var-ui/core</code>, generated at build time. Search, sort, and resize columns to explore
      the full catalog.
    </p>
    <TokenReferenceTable client:load rows={rows} />
  </section>
</div>
