---
import { SHOWCASE_THEMES } from './homepage/showcaseThemes';
import { defaultThemeClassName } from '@var-ui/core';
import { DOCS_THEME_STORAGE_KEY } from '../lib/docs-theme';

const themeMap = Object.fromEntries(SHOWCASE_THEMES.map((theme) => [theme.id, theme.className]));
const allClasses = SHOWCASE_THEMES.map((theme) => theme.className);
const defaultThemeId = 'default';
---

<script is:inline define:vars={{ themeMap, allClasses, defaultThemeId, storageKey: DOCS_THEME_STORAGE_KEY, defaultThemeClassName }}>
  function applyDocsTheme(doc) {
    const root = doc.documentElement;
    const stored = localStorage.getItem(storageKey);
    const className = themeMap[stored] ?? themeMap[defaultThemeId] ?? defaultThemeClassName;
    for (const cls of allClasses) {
      root.classList.remove(cls);
    }
    root.classList.add(className);
  }

  applyDocsTheme(document);

  const navKey = '__varUiDocsThemeNav';
  if (!window[navKey]) {
    window[navKey] = true;
    document.addEventListener('astro:before-swap', (event) => {
      applyDocsTheme(event.newDocument);
    });
    document.addEventListener('astro:after-swap', () => {
      applyDocsTheme(document);
    });
  }
</script>
