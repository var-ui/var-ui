---
import { mergeProps } from '@var-ui/astro';
import { varUiWordmark } from '../styles/varUiWordmark';

type Props = {
  as?: 'h1' | 'span';
  className?: string;
  size?: 'hero' | 'header';
};

const { as = 'span', className, size = 'hero' } = Astro.props;
const wordmark = varUiWordmark({ size });
const Tag = as;
---

<Tag {...mergeProps(wordmark.root, className)} aria-label="Var UI">
  <span {...mergeProps(wordmark.keyword)} aria-hidden="true">var</span><span
    {...mergeProps(wordmark.punctuation)}
    aria-hidden="true"
  >(</span><span {...mergeProps(wordmark.customProperty)} aria-hidden="true">--ui</span><span
    {...mergeProps(wordmark.punctuation)}
    aria-hidden="true"
  >)</span>
</Tag>
