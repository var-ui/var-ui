---
import { combobox } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const cb = combobox();
---

<div {...mergeProps(cb.root)}>
  <label {...mergeProps(cb.label)} for="fruit-search">Favorite fruit</label>
  <div {...mergeProps(cb.inputWrapper)}>
    <input
      {...mergeProps(cb.input)}
      id="fruit-search"
      type="text"
      placeholder="Search fruits…"
      role="combobox"
      aria-autocomplete="list"
    />
  </div>
</div>
