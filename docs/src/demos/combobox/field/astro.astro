---
import { combobox } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const cb = combobox();
---

<div {...mergeProps(cb.root)}>
  <label {...mergeProps(cb.label)} for="fruit-field">Favorite fruit</label>
  <div {...mergeProps(cb.inputWrapper)}>
    <input
      {...mergeProps(cb.input)}
      id="fruit-field"
      type="text"
      placeholder="Search fruits…"
      role="combobox"
      aria-invalid="true"
    />
  </div>
  <p {...mergeProps(cb.description)}>Pick a fruit from the list.</p>
  <p {...mergeProps(cb.error)}>Selection is required.</p>
</div>
