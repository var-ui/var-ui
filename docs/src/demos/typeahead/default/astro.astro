---
import { combobox } from '@var-ui/core';
import { recipeProps } from '../../../lib/recipeProps';

const cb = combobox();
---

<div {...recipeProps(cb.root)}>
  <label {...recipeProps(cb.label)} for="fruit-typeahead">Fruit</label>
  <div {...recipeProps(cb.inputWrapper)}>
    <input
      {...recipeProps(cb.input)}
      id="fruit-typeahead"
      type="text"
      placeholder="Search…"
      role="combobox"
      aria-autocomplete="list"
    />
  </div>
</div>
