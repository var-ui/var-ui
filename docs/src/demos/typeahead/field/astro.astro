---
import { combobox } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const cb = combobox();
---

<div {...mergeProps(cb.root)}>
  <label {...mergeProps(cb.label)} for="fruit-typeahead-field">Fruit</label>
  <div {...mergeProps(cb.inputWrapper)}>
    <input
      {...mergeProps(cb.input)}
      id="fruit-typeahead-field"
      type="text"
      placeholder="Search…"
      role="combobox"
      aria-invalid="true"
    />
  </div>
  <p {...mergeProps(cb.description)}>Start typing to filter the list.</p>
  <p {...mergeProps(cb.error)}>Choose a fruit to continue.</p>
</div>
