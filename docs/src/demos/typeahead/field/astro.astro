---
import { combobox } from '@var-ui/core';
import { recipeProps } from '../../../lib/recipeProps';

const cb = combobox();
---

<div {...recipeProps(cb.root)}>
  <label {...recipeProps(cb.label)} for="fruit-typeahead-field">Fruit</label>
  <div {...recipeProps(cb.inputWrapper)}>
    <input
      {...recipeProps(cb.input)}
      id="fruit-typeahead-field"
      type="text"
      placeholder="Search…"
      role="combobox"
      aria-invalid="true"
    />
  </div>
  <p {...recipeProps(cb.description)}>Start typing to filter the list.</p>
  <p {...recipeProps(cb.error)}>Choose a fruit to continue.</p>
</div>
