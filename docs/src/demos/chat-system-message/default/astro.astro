---
import { chatSystemMessage } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

// No @var-ui/astro ChatSystemMessage — core recipe markup.
const info = chatSystemMessage({ tone: 'info' });
const success = chatSystemMessage({ tone: 'success' });
---

<div {...mergeProps(info.root)} role="status">
  <span {...mergeProps(info.text)}>Model switched to GPT-5</span>
</div>
<div {...mergeProps(success.root)} role="status">
  <span {...mergeProps(success.text)}>Alex joined the conversation</span>
</div>
