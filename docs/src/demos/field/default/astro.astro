---
import { field } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const f = field();
---

<div {...mergeProps(f.root)}>
  <label {...mergeProps(f.label)} for="custom-range">Custom control</label>
  <input id="custom-range" type="range" />
  <p {...mergeProps(f.description)}>Any input composes the shared field chrome.</p>
</div>
