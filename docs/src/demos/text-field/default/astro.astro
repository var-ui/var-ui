---
import { textField } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const tf = textField();
---

<div {...mergeProps(tf.root)}>
  <label {...mergeProps(tf.label)} for="project-name">Project name</label>
  <input
    {...mergeProps(tf.input)}
    id="project-name"
    type="text"
    placeholder="My project"
  />
  <p {...mergeProps(tf.description)}>Shown on the dashboard.</p>
</div>
