---
import { slider } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const s = slider();
const value = 40;
---

<div {...mergeProps(s.root)} role="group" aria-label="Volume">
  <label {...mergeProps(s.label)}>
    <span>Volume</span>
    <span {...mergeProps(s.output)}>{value}</span>
  </label>
  <div {...mergeProps(s.control)}>
    <div {...mergeProps(s.track)}>
      <div {...mergeProps(s.fill)} style={`width: ${value}%`}></div>
    </div>
    <div
      {...mergeProps(s.thumb)}
      role="slider"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow={value}
      tabindex="0"
      style={`top: 50%; left: ${value}%; transform: translate(-50%, -50%)`}
    ></div>
  </div>
</div>
