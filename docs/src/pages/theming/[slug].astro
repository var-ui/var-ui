---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ColorSwatches from '../../components/ColorSwatches.astro';
import CssVariableReference from '../../components/CssVariableReference.astro';
import ShadowSwatches from '../../components/ShadowSwatches.astro';
import { findMdxModule } from '../../lib/loadMdx';

const slug = Astro.params.slug;
if (!slug || slug === 'index') {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const modules = import.meta.glob('../../../content/theming/*.mdx');
const loader = findMdxModule(modules, slug);
if (!loader) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { Content, frontmatter } = await loader();
---

<BaseLayout title={`${frontmatter.title} · Var UI`}>
  <article
    class:list={[
      'docs-article',
      (slug === 'colors' || slug === 'shadows') && 'docs-article--wide',
    ]}
  >
    <Content components={{ ColorSwatches, CssVariableReference, ShadowSwatches }} />
  </article>
</BaseLayout>

<style>
  .docs-article {
    max-width: 48rem;
  }

  .docs-article--wide {
    max-width: 72rem;
  }

  .docs-article :global(h1) {
    margin-block: 0 0.5rem;
    font-size: 2rem;
    line-height: 1.2;
  }

  .docs-article :global(h2) {
    margin-block: 2rem 0.75rem;
    font-size: 1.35rem;
  }

  .docs-article :global(h3) {
    margin-block: 1.5rem 0.5rem;
    font-size: 1.1rem;
  }

  .docs-article :global(p),
  .docs-article :global(li) {
    margin-block: 0.75rem;
    line-height: 1.6;
  }

  .docs-article :global(code) {
    font-size: 0.9em;
  }
</style>
