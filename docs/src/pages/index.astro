---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageIsland from '../components/homepage/HomepageIsland';
import homepagePreloads from 'virtual:homepage-preloads';

const framework = Astro.locals.framework;
---

<BaseLayout title="Var UI">
  <Fragment slot="head">
    {homepagePreloads.map((href) => <link rel="modulepreload" href={href} crossorigin />)}
  </Fragment>
  <h1>Var UI</h1>
  <p>
    An open-source design system built on TypeStyles and React Aria Components. Explore the
    docs, browse components, or learn about theming from the navigation above.
  </p>

  <HomepageIsland client:load framework={framework} />

  <h2>Explore</h2>
  <ul>
    <li>
      <a href="/docs">Documentation</a> — installation and getting started guides
    </li>
    <li>
      <a href="/components">Components</a> — live demos for every exported component
    </li>
    <li>
      <a href="/theming">Theming</a> — tokens, themes, and color modes
    </li>
  </ul>
</BaseLayout>
