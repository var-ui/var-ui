---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Example Docs" showToc={false}>
  <article class="home">
    <h1>Example Docs</h1>
    <p>
      A minimal guide-only site that consumes <code>@var-ui/docs</code> — shell, MDX guides,
      TOC, search, and color mode — without the design-system catalog plugins.
    </p>
    <p>
      <a href="/docs">Open the documentation →</a>
    </p>
  </article>
</BaseLayout>

<style>
  .home {
    max-width: 40rem;
    padding: 2rem 0;
  }

  .home h1 {
    margin-block: 0 0.75rem;
    font-size: 2rem;
    line-height: 1.2;
  }

  .home p {
    margin-block: 0.75rem;
    line-height: 1.6;
  }
</style>
