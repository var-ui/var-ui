{
  "name": "var-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "build": "vp run -F @var-ui/core -F @var-ui/react -F @var-ui/form -F @var-ui/icons build",
    "build:bundle-fixtures": "vp run -F @var-ui/bundle-fixture-button-only -F @var-ui/bundle-fixture-form-kit -F @var-ui/bundle-fixture-date-kit -F @var-ui/example-vite-app build",
    "test:bundle-budgets": "pnpm build && pnpm build:bundle-fixtures && node scripts/bundle-budget.mjs",
    "test:bundle-budgets:update": "pnpm build && pnpm build:bundle-fixtures && node scripts/bundle-budget.mjs --update",
    "pack": "vp run -F @var-ui/core -F @var-ui/react -F @var-ui/form -F @var-ui/icons pack",
    "dev": "vp run @var-ui/example-vite-app#dev",
    "docs:dev": "vp run @var-ui/docs#dev",
    "docs:build": "vp run @var-ui/docs#build",
    "docs:preview": "vp run @var-ui/docs#preview",
    "astro:check": "vp run @var-ui/example-astro-app#check",
    "ready": "vp check && vp test run && vp run -F @var-ui/core -F @var-ui/react -F @var-ui/form -F @var-ui/icons build && pnpm test:bundle-budgets"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.0.0",
    "@typestyles/eslint-plugin": "^0.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.11.1"
}
