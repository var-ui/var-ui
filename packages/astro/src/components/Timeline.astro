---
import { timeline, type TimelineVariantProps } from '@var-ui/core';
import { recipeProps } from '../utils';

interface Props extends TimelineVariantProps {
  className?: string;
}

const { size = 'md', tone = 'accent', className } = Astro.props;
const styles = timeline({ size, tone });
---

<ol {...recipeProps(styles.root, className)} data-timeline>
  <slot />
</ol>
