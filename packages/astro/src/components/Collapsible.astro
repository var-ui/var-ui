---
import { collapsible, defaultIconSvgs } from '@var-ui/core';
import { recipeProps } from '../utils';

type Props = {
  id?: string;
  title?: string;
  defaultExpanded?: boolean;
  variant?: 'flush' | 'bordered';
  className?: string;
};

const {
  id,
  title,
  defaultExpanded = false,
  variant = 'flush',
  className,
} = Astro.props;

const c = collapsible({ variant });
const hasTriggerSlot = Astro.slots.has('trigger');
---

<details id={id} open={defaultExpanded || undefined} {...recipeProps(c.root, className)}>
  <summary {...recipeProps(c.trigger)}>
    {
      hasTriggerSlot ? (
        <slot name="trigger" />
      ) : (
        <>
          <span {...recipeProps(c.triggerIcon)} set:html={defaultIconSvgs.chevronDown} />
          {title}
        </>
      )
    }
  </summary>
  <div {...recipeProps(c.panel)}>
    <slot />
  </div>
</details>
