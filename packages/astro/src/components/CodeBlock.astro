---
import { codeBlock, defaultIconSvgs } from '@var-ui/core';
import { cx, recipeClassName, recipeProps } from '../utils';

type CodeBlockVariant = 'default' | 'inline' | 'diff' | 'terminal';

type Props = {
  code: string;
  language?: string;
  codeHtml?: string;
  codeClassName?: string;
  lineHtml?: string[];
  filename?: string;
  className?: string;
  copyable?: boolean;
  variant?: CodeBlockVariant;
  wrapLongLines?: boolean;
  showLineNumbers?: boolean;
  highlightedLines?: number[];
  copyLabel?: string;
  copiedLabel?: string;
  copyErrorLabel?: string;
};

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

const {
  code,
  language,
  codeHtml,
  codeClassName: highlightedCodeClassName,
  lineHtml,
  filename,
  className,
  copyable = true,
  variant = 'default',
  wrapLongLines = false,
  showLineNumbers = false,
  highlightedLines = [],
  copyLabel = 'Copy code',
  copiedLabel = 'Copied',
  copyErrorLabel = 'Copy failed',
} = Astro.props as Props;

const cb = codeBlock();
const variantRootClass: Record<CodeBlockVariant, string> = {
  default: recipeClassName(cb.rootDefault),
  inline: recipeClassName(cb.rootInline),
  diff: recipeClassName(cb.rootDiff),
  terminal: recipeClassName(cb.rootTerminal),
};

const highlightedSet = new Set(highlightedLines);
const lines = code.replace(/\n$/, '').split('\n');
const terminal = variant === 'terminal';
const inline = variant === 'inline';
const useHighlightedHtml = Boolean(codeHtml || lineHtml) && !terminal;
const resolvedCodeClassName = cx(recipeClassName(cb.code), highlightedCodeClassName);

const feedbackClassName = cx(
  recipeClassName(cb.feedback),
  recipeClassName(cb.feedbackInline),
);
---

{
  inline ? (
    <code
      {...recipeProps(
        cb.root,
        cx(variantRootClass[variant], recipeClassName(cb.code), className),
      )}
      data-codeblock
    >
      {code}
    </code>
  ) : (
    <div {...recipeProps(cb.root, cx(variantRootClass[variant], className))} data-codeblock>
      <div
        {...recipeProps(cb.header, cx(terminal && recipeClassName(cb.headerTerminal)))}
        data-codeblock-header
      >
        <div {...recipeProps(cb.title)}>
          {filename ? <span {...recipeProps(cb.filename)}>{filename}</span> : null}
          {language ? (
            <span
              {...recipeProps(cb.language, cx(terminal && recipeClassName(cb.languageTerminal)))}
            >
              {language}
            </span>
          ) : null}
        </div>
        {copyable ? (
          <div {...recipeProps(cb.actions)}>
            <button
              type="button"
              {...recipeProps(
                cb.copyButton,
                cx(recipeClassName(cb.copyButtonIdle)),
              )}
              data-var-ui-code-copy
              data-code={code}
              data-copy-label={copyLabel}
              data-copied-label={copiedLabel}
              data-copy-error-label={copyErrorLabel}
              data-class-idle={recipeClassName(cb.copyButtonIdle)}
              data-class-copied={recipeClassName(cb.copyButtonCopied)}
              data-class-error={recipeClassName(cb.copyButtonError)}
              aria-label={copyLabel}
            >
              <span data-codeblock-copy-icon set:html={defaultIconSvgs.copy} />
              <span data-codeblock-copy-text>Copy</span>
            </button>
            <span
              class={feedbackClassName}
              data-codeblock-feedback
              data-class-success={recipeClassName(cb.feedbackSuccess)}
              data-class-error={recipeClassName(cb.feedbackError)}
              role="status"
              aria-live="polite"
            />
          </div>
        ) : null}
      </div>

      <div
        {...recipeProps(
          cb.body,
          cx(recipeClassName(cb.bodyScrollable), terminal && recipeClassName(cb.bodyTerminal)),
        )}
        data-codeblock-body
      >
        <pre
          {...recipeProps(
            cb.pre,
            cx(
              wrapLongLines ? recipeClassName(cb.preWrap) : recipeClassName(cb.preScrollX),
              terminal && recipeClassName(cb.preTerminal),
            ),
          )}
          data-codeblock-pre>{showLineNumbers ? (
            <code {...recipeProps(cb.code, recipeClassName(cb.lines))}>
              {lines.map((line, index) => {
                const lineNumber = index + 1;
                const lineContentHtml = lineHtml?.[index];
                return (
                  <span
                    {...recipeProps(
                      cb.line,
                      cx(highlightedSet.has(lineNumber) && recipeClassName(cb.lineHighlighted)),
                    )}
                  >
                    <span {...recipeProps(cb.lineNumber)} aria-hidden="true">
                      {lineNumber}
                    </span>
                    {lineContentHtml ? (
                      <span
                        {...recipeProps(cb.lineContent)}
                        set:html={lineContentHtml}
                      />
                    ) : (
                      <span {...recipeProps(cb.lineContent)}>{line || ' '}</span>
                    )}
                  </span>
                );
              })}
            </code>
          ) : useHighlightedHtml ? (
            <code {...recipeProps(cb.code, resolvedCodeClassName)} set:html={codeHtml} />
          ) : (
            <code {...recipeProps(cb.code)}>{escapeHtml(code)}</code>
          )}</pre>
      </div>
    </div>
  )
}

{
  !inline && copyable ? (
    <script>
      import { initCodeBlockCopy } from '../scripts/codeBlockCopy';
      initCodeBlockCopy();
    </script>
  ) : null
}
