---
import { badge, type BadgeVariantProps } from '@var-ui/core';
import { recipeProps } from '../utils';

interface Props extends BadgeVariantProps {
  className?: string;
}

const { tone = 'neutral', appearance = 'subtle', className } = Astro.props;
const rp = recipeProps(badge({ tone, appearance }), className);
---
<span {...rp}><slot /></span>
