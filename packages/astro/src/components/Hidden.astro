---
import {
  hiddenClassName,
  type HiddenMap,
} from '@var-ui/core/hidden';
import { recipeProps } from '../utils';

type Props = {
  hide?: boolean | HiddenMap;
  as?: string;
  className?: string;
};

const { hide, as = 'div', className } = Astro.props;
const rp = recipeProps(hiddenClassName({ hide }), className);
const Tag = as;
---
<Tag {...rp}><slot /></Tag>
