---
import {
  collapsible,
  type CollapsibleVariantProps,
} from '@var-ui/core/collapsible';
import { defaultIconSvgs } from '@var-ui/core/icons';
import { recipeProps } from '../utils';

interface Props extends CollapsibleVariantProps {}

const { variant = 'accordion' } = Astro.props;
const c = collapsible({ variant });
---

<span slot="trigger">
  <span {...recipeProps(c.triggerIcon)} set:html={defaultIconSvgs.chevronDown} />
  <slot />
</span>
