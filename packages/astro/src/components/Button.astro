---
import { button, resolveButtonProps, type ButtonVariantProps } from '@var-ui/core';
import { recipeProps } from '../utils';

interface Props extends ButtonVariantProps {
  className?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const {
  intent,
  tone,
  appearance,
  size = 'md',
  className,
  type = 'button',
  disabled,
} = Astro.props;
const rp = recipeProps(
  button(resolveButtonProps({ intent, tone, appearance, size })),
  className,
);
---

<button type={type} disabled={disabled} {...rp}><slot /></button>
