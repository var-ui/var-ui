---
import { toc } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  label: string;
  href: string;
  isSelected?: boolean;
  isNested?: boolean;
  className?: string;
};

const { label, href, isSelected = false, isNested = false, className } = Astro.props;
const s = toc();
const linkProps = {
  ...mergeProps(s.link, className),
  ...(isSelected ? { 'data-selected': '' } : {}),
  'aria-current': isSelected ? ('location' as const) : undefined,
};
---

<li {...mergeProps(s.item)} data-nested={isNested || undefined}>
  <a href={href} {...linkProps}>
    {label}
  </a>
</li>
