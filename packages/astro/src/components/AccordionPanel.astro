---
import { collapsible, type CollapsibleVariantProps } from '@var-ui/core';
import { recipeProps } from '../utils';

interface Props extends CollapsibleVariantProps {
  className?: string;
}

const { variant = 'accordion', className } = Astro.props;
const c = collapsible({ variant });
---

<div slot="panel" {...recipeProps(c.panel, className)}>
  <slot />
</div>
