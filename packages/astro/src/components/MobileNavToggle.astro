---
import { defaultIconSvgs, icon, mobileNav } from '@var-ui/core';
import { recipeProps } from '../utils';

type Props = {
  label?: string;
  className?: string;
};

const { label = 'Open navigation', className } = Astro.props;
const s = mobileNav();
const hasIcon = Astro.slots.has('default');
const iconRecipe = recipeProps(icon({ size: 'md' }));
---

<button
  type="button"
  data-var-ui-mobile-nav-toggle
  aria-label={label}
  aria-expanded="false"
  {...recipeProps(s.toggle, className)}
>
  {hasIcon ? <slot /> : <span {...iconRecipe} set:html={defaultIconSvgs.menu} />}
</button>

<script>
  import { initMobileNavToggles } from '../scripts/mobileNav';
  initMobileNavToggles();
</script>
