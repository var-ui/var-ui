---
import { chip, type ChipVariantProps } from '@var-ui/core';
import { recipeProps } from '../utils';

interface Props extends ChipVariantProps {
  className?: string;
}

const { tone = 'neutral', appearance = 'subtle', className } = Astro.props;
const c = chip({ tone, appearance });
---

<span {...recipeProps(c.root, className)}>
  <span {...recipeProps(c.label)}><slot /></span>
</span>
