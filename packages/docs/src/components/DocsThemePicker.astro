---
import config from "virtual:var-docs/config";
import {
  button,
  defaultIconSvgs,
  icon,
  menu,
  resolveButtonProps,
} from "@var-ui/core";
import { mergeProps } from "@var-ui/astro";
import { docsThemePicker } from "../styles/docsThemePicker";
import { resolveThemePresets } from "../utils/theme/presets";

const presets = resolveThemePresets(config.theme.presets);
const storageKey = config.theme.storageKey;
const fallbackClassName = config.theme.defaultClassName;
const defaultThemeId = presets[0]?.id ?? "default";

const s = docsThemePicker();
const m = menu();
const triggerRecipe = mergeProps(
  button(
    resolveButtonProps({ appearance: "outline", layout: "icon", size: "md" }),
  ),
);
const iconRecipe = mergeProps(icon({ size: "md" }));
const checkIconRecipe = mergeProps(icon({ size: "sm" }));
const popoverRecipe = mergeProps(m.popover, s.menu);
const menuRecipe = mergeProps(m.menu);
const sectionHeaderRecipe = mergeProps(m.sectionHeader);
const itemRecipe = mergeProps(m.item, s.itemReset);
const itemCheckRecipe = mergeProps(m.itemCheck);
const itemLabelRecipe = mergeProps(m.itemLabel);

const presetsJson = JSON.stringify(
  presets.map((theme) => ({
    id: theme.id,
    label: theme.label,
    className: theme.className,
    swatch: theme.swatch,
    lazyCss: theme.lazyCss,
  })),
);

const defaultSwatch = presets[0]?.swatch ?? "#64748b";
---

{presets.length > 0 ? (
  <div transition:persist="docs-theme-picker">
    <div
      class={s.root}
      data-docs-theme-picker
      data-presets={presetsJson}
      data-storage-key={storageKey}
      data-fallback-class={fallbackClassName}
    >
      <button
        type="button"
        data-docs-theme-picker-trigger
        aria-label="Choose site theme"
        aria-haspopup="menu"
        aria-expanded="false"
        {...triggerRecipe}
      >
        <span {...iconRecipe} aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <rect
              x="4"
              y="4"
              width="7"
              height="7"
              rx="1.75"
              fill={defaultSwatch}
              stroke="currentColor"
              stroke-width="1.25"
              data-docs-theme-picker-swatch
            />
            <rect
              x="13"
              y="4"
              width="7"
              height="7"
              rx="1.75"
              fill="currentColor"
              opacity="0.22"
            />
            <rect
              x="4"
              y="13"
              width="7"
              height="7"
              rx="1.75"
              fill="currentColor"
              opacity="0.38"
            />
            <rect
              x="13"
              y="13"
              width="7"
              height="7"
              rx="1.75"
              fill="currentColor"
              opacity="0.55"
            />
          </svg>
        </span>
      </button>
      <div data-docs-theme-picker-menu hidden {...popoverRecipe}>
        <div role="menu" aria-label="Site theme" {...menuRecipe}>
          <div role="presentation" {...sectionHeaderRecipe}>
            Theme
          </div>
          {presets.map((theme) => (
            <button
              type="button"
              role="menuitemradio"
              data-theme-id={theme.id}
              aria-checked="false"
              {...itemRecipe}
            >
              <span
                {...itemCheckRecipe}
                data-docs-theme-picker-check
                aria-hidden="true"
              >
                <span {...checkIconRecipe} set:html={defaultIconSvgs.check} />
              </span>
              <span
                class={s.itemSwatch}
                style={{ backgroundColor: theme.swatch ?? "currentColor" }}
              />
              <span {...itemLabelRecipe}>{theme.label}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
    <script
      is:inline
      define:vars={{
        storageKey,
        presetsJson,
        defaultThemeId,
      }}
    >
      (function () {
        try {
          var presets = JSON.parse(presetsJson);
          var stored = localStorage.getItem(storageKey);
          var selectedId = stored;
          var ids = presets.map(function (preset) {
            return preset.id;
          });
          if (!selectedId || ids.indexOf(selectedId) === -1) {
            selectedId = defaultThemeId;
          }
          var selected =
            presets.find(function (preset) {
              return preset.id === selectedId;
            }) || presets[0];
          if (!selected) return;

          document
            .querySelectorAll("[data-docs-theme-picker]")
            .forEach(function (root) {
              var swatch = root.querySelector(
                "[data-docs-theme-picker-swatch]",
              );
              if (swatch)
                swatch.setAttribute("fill", selected.swatch || "#64748b");
              root.querySelectorAll("[data-theme-id]").forEach(function (item) {
                var id = item.getAttribute("data-theme-id");
                var isSelected = id === selectedId;
                item.setAttribute("aria-checked", String(isSelected));
              });
            });
        } catch (_) {}
      })();
    </script>
  </div>
) : null}

<script>
  import { initDocsThemePickers } from "../scripts/docsThemePicker";
  initDocsThemePickers();
</script>
