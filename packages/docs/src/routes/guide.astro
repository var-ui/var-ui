---
/**
 * Injected catch-all for guide content collections configured in `varDocs({ routes })`.
 * Layout and MDX shortcodes come from virtual modules configured in `varDocs()`.
 * Sites with SSR or multiple prefixes should set `disableGuideRoutes: true` and use
 * `@var-ui/docs/DocsGuidePage` in their own pages instead.
 * `injectRoute({ prerender })` owns static vs SSR — do not export `prerender` here.
 */
import { getCollection } from 'astro:content';
import DocsGuidePage from '../components/DocsGuidePage.astro';
import Layout from 'virtual:var-docs/components/Layout';
import * as mdxComponents from 'virtual:var-docs/mdx-components';
import config from 'virtual:var-docs/config';
import {
  assertSingleStaticGuidePrefix,
  guideCatchAllStaticPaths,
  resolveGuideRouteConfig,
} from '../utils/routing';

export async function getStaticPaths() {
  const routes = resolveGuideRouteConfig(config.routes);
  assertSingleStaticGuidePrefix(routes);
  const [route] = routes;
  const entries = await getCollection(route.collection);
  return guideCatchAllStaticPaths(entries);
}
---

<DocsGuidePage layout={Layout} mdxComponents={mdxComponents} stripBase />
